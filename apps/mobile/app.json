{
  "expo": {
    "name": "Leeloo",
    "slug": "leeloo",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B5CF6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyperbyte.leeloo",
      "buildNumber": "32",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Leeloo necesita el micrófono para escuchar tus comandos de voz.",
        "NSCalendarsUsageDescription": "Leeloo necesita acceso a tu calendario para programar eventos.",
        "NSSpeechRecognitionUsageDescription": "Leeloo usa reconocimiento de voz para entender tus comandos.",
        "NSLocationWhenInUseUsageDescription": "Leeloo usa tu ubicación para darte el clima, recordatorios por zona y respuestas contextuales precisas.",
        "NSSiriUsageDescription": "Leeloo usa Siri para que puedas activar tu asistente con tu voz desde cualquier lugar.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.hyperbyte.leeloo.refresh"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D266C"
      },
      "package": "com.leeloo.app",
      "versionCode": 32,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CALL_PHONE",
        "com.android.alarm.permission.SET_ALARM",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withLeelooWakeWord",
      "./plugins/withLeelooShortcuts",
      "./plugins/withLeelooSiri",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Leeloo to access your calendar."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Leeloo to use your microphone for voice commands."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Leeloo usa tu ubicación para darte el clima, recordatorios por zona y respuestas contextuales precisas."
        }
      ]
    ],
    "scheme": "leeloo",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b2e0fbb8-1cc1-4997-b6c9-83732a758597"
      },
      "EXPO_PUBLIC_LOG_AUTH_TOKEN": "false"
    },
    "owner": "mikezelda"
  }
}
