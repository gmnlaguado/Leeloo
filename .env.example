# Leeloo monorepo - root env example
# Each service ALSO has its own .env.example with the subset it needs.
# In production, set these in your hosting provider's secret manager (Render dashboard).

# --------------------------------------------------------------- Core infra
NODE_ENV=production
LOG_LEVEL=info

# Supabase Postgres + Auth (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# Encryption (AES-256-GCM for OAuth tokens at rest)
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters (32 bytes). Same value across API + worker.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# When rotating, keep the old key reachable as ENCRYPTION_KEY_V1 / V2 / ... so
# old ciphertexts can still be decrypted while new writes use the current key.

# Clerk JWKS for backend JWT verification (no shared JWT_SECRET — Clerk is asymmetric)
CLERK_JWKS_URL=https://xxxx.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://xxxx.clerk.accounts.dev
CLERK_AUDIENCE=

# Google OAuth (for Calendar + Gmail integrations)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPE=openid email profile https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.readonly

# Microsoft OAuth (for Outlook Calendar)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_SCOPE=offline_access https://graph.microsoft.com/Calendars.Read

# Redis (Upstash recommended - free tier 10k cmd/day)
# Format: rediss://default:PASSWORD@HOST:PORT
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# Clerk (use prod keys, not dev_)
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# OpenAI
OPENAI_API_KEY=sk-proj-xxx
OPENAI_MODEL=gpt-4o-mini

# Azure Speech (Speaker Recognition + STT fallback)
AZURE_SPEECH_KEY=xxx
AZURE_SPEECH_REGION=eastus

# ElevenLabs TTS
ELEVENLABS_API_KEY=xxx
ELEVENLABS_VOICE_ID=xxx
TTS_PROVIDER=elevenlabs   # elevenlabs | azure | none

# Resend (transactional email)
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@leeloo.app

# Expo Push (server-side, get from expo.dev access tokens)
EXPO_ACCESS_TOKEN=xxx

# Sentry (one DSN per project)
SENTRY_DSN_API=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN_AI=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN_WORKER=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN_STT=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN_MOBILE=https://xxx@xxx.ingest.sentry.io/xxx

# Service URLs (set automatically on Render via fromService)
AI_ORCHESTRATOR_URL=https://leeloo-ai.onrender.com
STT_URL=https://leeloo-stt.onrender.com
API_URL=https://leeloo-api.onrender.com

# Shared internal secret (NOT user-facing). Must match the STT service's
# STT_SHARED_SECRET. Sent as `Authorization: Bearer <token>` by internal
# callers of the STT service's POST /v1/transcribe.
STT_SHARED_SECRET=changeme-shared-secret

# CORS allow-list (comma-separated)
ALLOWED_ORIGINS=https://leeloo.app,https://www.leeloo.app
