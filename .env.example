# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# Redis
REDIS_URL=redis://localhost:6379

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/integrations/oauth/google/callback

# OAuth - Microsoft (Outlook)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://your-domain.com/api/v1/integrations/oauth/microsoft/callback

# App Config
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:19006

# Security
JWT_SECRET=your-jwt-secret-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-min

# Sentry (optional)
SENTRY_DSN=

# Stripe (for payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Wake Word Detection
PICOVOICE_ACCESS_KEY=your-picovoice-key

# Feature Flags
ENABLE_VOICE_LOGGING=false
ENABLE_ANALYTICS=true
ENABLE_CHILD_MODE=true
