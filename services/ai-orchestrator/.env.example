NODE_ENV=production
PORT=3002
LOG_LEVEL=info

# Clerk JWT auth (verified via JWKS, no shared secret) — required in production.
# Must match the same Clerk instance/env vars used by services/api.
CLERK_JWKS_URL=https://xxx.clerk.dev/.well-known/jwks.json
CLERK_ISSUER=
CLERK_AUDIENCE=

# Local development only — never set these in production.
# DEV_BYPASS_AUTH=true
# DEV_AUTH_TOKEN=
# DEV_USER_ID=dev-user

REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

OPENAI_API_KEY=sk-proj-xxx
OPENAI_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=xxx
ELEVENLABS_VOICE_ID=xxx
TTS_PROVIDER=elevenlabs

AZURE_SPEECH_KEY=xxx
AZURE_SPEECH_REGION=eastus

STT_URL=http://localhost:9000

# Shared internal secret (NOT user-facing). Must match the STT service's
# STT_SHARED_SECRET. Send as `Authorization: Bearer <token>` on any call
# to the STT service's POST /v1/transcribe.
STT_SHARED_SECRET=changeme-shared-secret

SENTRY_DSN=
