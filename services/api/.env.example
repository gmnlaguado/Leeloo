STT_ENDPOINT=http://localhost:9000
# Shared secret sent as "Authorization: Bearer <value>" to the stt service; must match STT_SHARED_SECRET there.
STT_SHARED_SECRET=

ALLOWED_ORIGINS=https://leeloo.app,https://www.leeloo.app
SENTRY_DSN=
