PORT=9000
WHISPER_MODEL_PATH=/models/ggml-base.bin
WHISPER_THREADS=2
SENTRY_DSN=

# Shared internal secret (NOT user-facing). Required bearer token that
# trusted callers (e.g. services/api, services/ai-orchestrator) must send
# as `Authorization: Bearer <token>` on POST /v1/transcribe. This service
# is internet-reachable in production, so this must be set to a long
# random value and kept identical to the value configured on the caller.
STT_SHARED_SECRET=changeme-shared-secret

# Optional: tune the in-memory per-IP rate limiter for /v1/transcribe.
STT_RATE_LIMIT_MAX_REQUESTS=10
STT_RATE_LIMIT_WINDOW_SECONDS=60
